{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "mcp_linear": {
      "type": "local",
      "command": ["bunx", "-y", "mcp-remote", "https://mcp.linear.app/mcp"]
    },
    "mcp_aws_pricing_calculator": {
      "type": "local",
      "command": ["bunx", "-y", "sample-aws-pricing-calculator-mcp@latest"]
    },
    "todoist": {
      "type": "remote",
      "url": "https://ai.todoist.net/mcp"
    },
    "docker_desktop": {
      "type": "local",
      "command": ["docker", "mcp", "gateway", "run", "--profile", "default"]
    }
  }
}
