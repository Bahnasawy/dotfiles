{
  "$schema": "https://opencode.ai/config.json",
  "lsp": true,
  "provider": {
    "cheaper-inference": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Cheaper Inference",
      "options": {
        "baseURL": "https://api.cheaperinference.com/v1"
      },
      "models": {
        "gpt-5.4": {
          "name": "GPT-5.4"
        },
        "deepseek-v4-flash": {
          "name": "Deepseek v4 Flash"
        }
      }
    }
  },
  "mcp": {
    "mcp_linear": {
      "type": "local",
      "command": ["bunx", "-y", "mcp-remote", "https://mcp.linear.app/mcp"],
      "enabled": false
    },
    "mcp_aws_pricing_calculator": {
      "type": "local",
      "command": ["bunx", "-y", "sample-aws-pricing-calculator-mcp@latest"],
      "enabled": false
    },
    "todoist": {
      "type": "remote",
      "url": "https://ai.todoist.net/mcp",
      "enabled": false
    },
    "docker_desktop": {
      "type": "local",
      "command": ["docker", "mcp", "gateway", "run", "--profile", "default"],
      "enabled": false
    }
  }
}
